---
title: Home
description: Projects, writing and news from Indi Gupte.
layout: layouts/base.njk
---
<section class="hero wrap">
  <h1>Indi <em>Gupte</em></h1>
  <p>[Short introduction coming soon]</p>
  <a class="btn" href="/about/">About Indi</a>
</section>

<section class="section wrap" aria-labelledby="projects-heading">
  <p class="eyebrow" id="projects-heading">Selected projects</p>
  <ul class="projects">
    {% for i in ["01", "02", "03"] %}
    <li>
      <span class="num" aria-hidden="true">{{ i }}</span>
      <div>
        <h3>[Project title]</h3>
        <p>[One line about this project]</p>
        <span class="tag">[Type]</span>
      </div>
    </li>
    {% endfor %}
  </ul>
</section>

<section class="section wrap" aria-labelledby="blog-heading">
  <p class="eyebrow" id="blog-heading">Latest from the blog</p>
  <article class="post-teaser">
    <time datetime="2026-10-07">[Date]</time>
    <h3>[Post title]</h3>
    <p class="muted">[First lines of the post]</p>
    <a href="/blog/">All posts</a>
  </article>
</section>

<div class="wrap">
  <section class="signup" aria-labelledby="signup-heading">
    <h2 id="signup-heading">Get new posts by email</h2>
    <p>Sign-up coming soon.</p>
  </section>
</div>
