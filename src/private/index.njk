    <label for="code">Access code</label>
    <input id="code" name="code" type="text" inputmode="text" autocapitalize="characters" spellcheck="false" required>
    <button class="btn" type="submit">Open file</button>
  </form>
  <p class="status" id="status" role="status" aria-live="polite"></p>

  <div class="viewer" id="viewer" hidden>
    <iframe title="Personal statement" src="about:blank"></iframe>
    <p class="actions">
      <a class="btn" id="download" href="#" download="indi-gupte-personal-statement.pdf">Download the PDF</a>
      <span class="muted">If the preview is blank on your phone, use the download button.</span>
    </p>
  </div>
</article>

